// Kush Enterprise — database schema (PostgreSQL + Prisma)
// Status: DRAFT FOR APPROVAL (Phase 0). Not yet wired into an app.
//
// Conventions
// - Money: Decimal(14,2) in INR. Rates: Decimal(14,2). GST %: Decimal(5,2).
// - Quantities: Int (pcs / box). Lens power: Decimal(5,2) dioptres (e.g. +21.50, -2.00).
// - All timestamps stored in UTC; displayed in Asia/Kolkata.
// - Catalogue tables carry updatedAt + deletedAt so the mobile app can delta-sync.
// - Documents (invoice, proforma, PO, credit note) SNAPSHOT party details, descriptions,
//   rates and tax so a later edit to a master never changes an issued document.
// - Stock is a ledger (StockMovement); StockBalance is a cached roll-up updated in the
//   same transaction, so scan-to-invoice reads one indexed row (< 300 ms target).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// 1. Identity, roles, permissions, audit
// =====================================================================

enum Role {
  OWNER
  EMPLOYEE
  CUSTOMER
}

/// Checkbox permissions the owner grants per employee (OWNER implicitly has all).
enum Permission {
  VIEW_ORDERS
  UPDATE_ORDER_STATUS
  CREATE_ORDERS
  CREATE_PROFORMA
  CREATE_TAX_INVOICE
  MANAGE_STOCK // stock adjustments, GRN
  SCAN_DISPATCH
  CREATE_PURCHASE_ORDERS
  MANAGE_CUSTOMERS
  VIEW_PRICES_MARGINS // see purchase cost, margins, price lists
  VIEW_ANALYTICS
  RECORD_PAYMENTS
  MANAGE_PRODUCTS
  VIEW_ACCOUNTS // ledgers, day book, trial balance
  MANAGE_ACCOUNTS // vouchers, purchase bills, supplier payments
}

model User {
  id           String       @id @default(cuid())
  role         Role
  name         String
  email        String?      @unique
  mobile       String?      @unique // E.164, used for OTP login
  passwordHash String? // argon2id; null for OTP-only customer logins
  permissions  Permission[] // only meaningful for EMPLOYEE
  isActive     Boolean      @default(true)
  lastLoginAt  DateTime?

  // Login protection
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  // A CUSTOMER user belongs to exactly one customer account (a hospital can have many logins).
  customerId String?
  customer   Customer? @relation("CustomerLogins", fields: [customerId], references: [id])

  sessions          Session[]
  otpCodes          OtpCode[]
  devices           Device[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  assignedCustomers Customer[]         @relation("AssignedEmployee")
  assignedOrders    SalesOrder[]       @relation("OrderAssignee")
  orderStatusEvents OrderStatusEvent[]
  stockMovements    StockMovement[]
  deliveries        Dispatch[]         @relation("Deliveries")
  invoicesCreated   Invoice[]          @relation("InvoiceCreatedBy")
  invoicesCancelled Invoice[]          @relation("InvoiceCancelledBy")
  priceChanges      PriceChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, isActive])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  client     String    @default("web") // web | mobile
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

model OtpCode {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  channel   NotificationChannel
  attempts  Int                 @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, expiresAt])
}

/// Push-notification tokens for the mobile app.
model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String // ios | android | web
  pushToken String   @unique
  lastSeen  DateTime @default(now())
}

/// Who did what, when. Written for status changes, invoices, stock adjustments, price changes, logins.
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "invoice.create", "order.status", "stock.adjust", "price.update"
  entityType String // "Invoice", "SalesOrder", "ProductVariant", ...
  entityId   String
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// =====================================================================
// 2. Settings, reference data, numbering
// =====================================================================

/// Single row (id = "company"). Placeholders until real details are supplied.
model CompanySettings {
  id                   String    @id @default("company")
  legalName            String    @default("Kush Enterprise")
  addressLine1         String    @default("[Company Address]")
  addressLine2         String?
  city                 String    @default("[City]")
  pincode              String    @default("[PIN]")
  stateCode            String    @default("XX") // GST state code, e.g. "24"
  phone                String?
  email                String?
  gstin                String    @default("[GSTIN]")
  pan                  String    @default("[PAN]")
  drugLicenceNo        String    @default("[Drug Licence No]")
  bankName             String    @default("[Bank Name]")
  bankAccountNo        String    @default("[A/c No]")
  bankIfsc             String    @default("[IFSC]")
  bankBranch           String    @default("[Branch]")
  upiId                String?
  signatureFileId      String?
  jurisdictionCity     String    @default("[City]")
  invoiceDeclaration   String    @default("We declare that this invoice shows the actual price of the goods described and that all particulars are true and correct.")
  defaultInvoiceTerms  String?
  defaultPoTerms       String?
  proformaValidityDays Int       @default(15)
  expiryAlertDays      Int[]     @default([30, 60, 90])
  defaultReorderLevel  Int       @default(5)
  gstRates             Decimal[] @db.Decimal(5, 2) // offered in product master, e.g. 0, 5, 12, 18
  units                String[]  @default(["pcs", "box", "set", "pack"])
  defaultInvoiceCopies String[]  @default(["ORIGINAL"]) // ORIGINAL | DUPLICATE | TRIPLICATE
  labelSizes           Json? // e.g. [{ "name": "50x25", "w": 50, "h": 25 }, ...]
  notificationConfig   Json? // channel toggles; API secrets live in env/secret store, not here
  /// Tally ledger names, e-invoice / e-way bill switches (no secrets).
  integrationConfig    Json?
  /// Accounts: the date opening balances are as on (start of the books kept in this app).
  booksFrom            DateTime? @db.Date
  /// Nothing dated on or before this can be entered, changed or cancelled (set after GST is filed).
  booksLockedUntil     DateTime? @db.Date
  updatedAt            DateTime  @updatedAt
}

/// Indian states/UTs with GST state codes; drives CGST+SGST vs IGST.
model State {
  code      String     @id // "27"
  name      String // "Maharashtra"
  shortCode String // "MH"
  customers Customer[]
}

enum DocType {
  TAX_INVOICE
  PROFORMA
  PURCHASE_ORDER
  CREDIT_NOTE
  GRN
  SALES_ORDER
  PAYMENT_RECEIPT
  DEBIT_NOTE
  PURCHASE_BILL
  PAYMENT_VOUCHER
  CONTRA_VOUCHER
  JOURNAL_VOUCHER
}

/// Per-financial-year numbering, e.g. KE/2026-27/0001. Allocated with SELECT ... FOR UPDATE.
model NumberSeries {
  id            String  @id @default(cuid())
  docType       DocType
  financialYear String // "2026-27"
  prefix        String // "KE/" | "KE/PI/" | "KE/PO/"
  nextNumber    Int     @default(1)
  padding       Int     @default(4)

  @@unique([docType, financialYear])
}

model FileAsset {
  id        String   @id @default(cuid())
  bucketKey String   @unique // S3 key
  mimeType  String
  sizeBytes Int
  purpose   String // product-image | invoice-pdf | signature | po-pdf | ...
  createdAt DateTime @default(now())
}

// =====================================================================
// 3. Customers (Doctors / Hospitals / Clinics) & suppliers
// =====================================================================

enum CustomerType {
  DOCTOR
  HOSPITAL
  CLINIC
}

model Customer {
  id               String       @id @default(cuid())
  code             String       @unique // CUST-0001
  type             CustomerType
  name             String
  contactPerson    String?
  mobile           String?
  email            String?
  stateCode        String
  state            State        @relation(fields: [stateCode], references: [code])
  gstin            String? // optional for individual doctors
  pan              String?
  drugLicenceNo    String?
  creditLimit      Decimal?     @db.Decimal(14, 2)
  paymentTermsDays Int          @default(30)
  notes            String?
  isActive         Boolean      @default(true)

  /// Linked doctors under a hospital (Dr. X at Hospital Y).
  /// How the customer wants order updates (in-app is always on). External channels need the provider accounts.
  notifyChannels NotificationChannel[] @default([IN_APP, PUSH])

  parentId String?
  parent   Customer?  @relation("HospitalDoctors", fields: [parentId], references: [id])
  doctors  Customer[] @relation("HospitalDoctors")

  assignedEmployeeId String?
  assignedEmployee   User?   @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])

  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id])

  logins         User[]          @relation("CustomerLogins")
  addresses      Address[]
  customPrices   CustomerPrice[]
  orders         SalesOrder[]    @relation("OrderCustomer")
  ordersAsDoctor SalesOrder[]    @relation("OrderForDoctor")
  proformas      Proforma[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  payments       Payment[]
  ledger         Ledger?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([name])
  @@index([assignedEmployeeId])
}

enum AddressKind {
  BILLING
  SHIPPING
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind       AddressKind
  label      String? // "Main OT", "Pharmacy"
  line1      String
  line2      String?
  city       String
  pincode    String
  stateCode  String
  gstin      String? // a branch can have its own GSTIN
  isDefault  Boolean     @default(false)

  @@index([customerId, kind])
}

model Supplier {
  id               String  @id @default(cuid())
  code             String  @unique // SUP-001
  name             String
  addressLine1     String
  addressLine2     String?
  city             String
  pincode          String?
  stateCode        String
  gstin            String?
  contactPerson    String?
  mobile           String?
  email            String?
  paymentTermsDays Int     @default(30)
  isActive         Boolean @default(true)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  returns        SupplierReturn[]
  ledger         Ledger?
  purchaseBills  PurchaseBill[]
  payments       SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierProduct {
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku      String?
  lastPurchaseRate Decimal?  @db.Decimal(14, 2)
  lastPurchasedAt  DateTime?

  @@id([supplierId, productId])
}

// =====================================================================
// 4. Products, variants (lens powers), barcodes
// =====================================================================

model Category {
  id        String    @id @default(cuid())
  name      String    @unique // IOL / Lens, Surgical Instrument, Consumable, Equipment
  products  Product[]
  updatedAt DateTime  @updatedAt
}

model Brand {
  id           String    @id @default(cuid())
  name         String    @unique
  manufacturer String?
  products     Product[]
  updatedAt    DateTime  @updatedAt
}

enum LensType {
  MONOFOCAL
  TORIC
  MULTIFOCAL
  EDOF
}

/// Model-level product (e.g. "LumaVue HA-600"). Pricing lives here; stock lives on variants.
model Product {
  id          String   @id @default(cuid())
  code        String   @unique // base SKU, e.g. "LV-HA600"; variant SKUs extend it
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  model       String?
  hsnCode     String
  gstRate     Decimal  @db.Decimal(5, 2)
  unit        String   @default("pcs")
  description String?
  imageIds    String[]

  purchaseCost Decimal @db.Decimal(14, 2) // owner / VIEW_PRICES_MARGINS only
  defaultRate  Decimal @db.Decimal(14, 2)
  mrp          Decimal @db.Decimal(14, 2)
  reorderLevel Int?

  trackBatch  Boolean @default(true)
  trackExpiry Boolean @default(true)
  trackSerial Boolean @default(false) // most IOLs carry a unique serial per lens

  // Lens attributes (null for non-lens products)
  isLens       Boolean   @default(false)
  lensType     LensType?
  material     String? // hydrophobic acrylic, hydrophilic, PMMA...
  aConstant    Decimal?  @db.Decimal(6, 2)
  opticSizeMm  Decimal?  @db.Decimal(4, 2)
  overallLenMm Decimal?  @db.Decimal(4, 2)
  preloaded    Boolean?

  isActive      Boolean @default(true)
  showOnWebsite Boolean @default(true)

  variants       ProductVariant[]
  priceListItems PriceListItem[]
  customerPrices CustomerPrice[]
  supplierLinks  SupplierProduct[]
  priceChanges   PriceChangeLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([brandId])
  @@index([updatedAt])
}

/// Stockable SKU. A lens model has one variant per power (and cylinder for torics);
/// an instrument usually has a single variant.
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String   @unique
  powerSph     Decimal? @db.Decimal(5, 2) // dioptres, filterable
  cylinder     Decimal? @db.Decimal(4, 2) // toric only
  addPower     Decimal? @db.Decimal(4, 2) // multifocal add
  label        String? // "+21.50 D", "Size M"
  barcode      String   @unique // our own Code 128 value
  gtin         String?  @unique // manufacturer GS1 GTIN-14
  // Optional per-variant overrides of product pricing (rare)
  purchaseCost Decimal? @db.Decimal(14, 2)
  mrp          Decimal? @db.Decimal(14, 2)
  reorderLevel Int?
  isActive     Boolean  @default(true)

  aliases             BarcodeAlias[]
  batches             Batch[]
  balances            StockBalance[]
  movements           StockMovement[]
  orderLines          SalesOrderLine[]
  proformaLines       ProformaLine[]
  invoiceLines        InvoiceLine[]
  poLines             PurchaseOrderLine[]
  grnLines            GrnLine[]
  creditNoteLines     CreditNoteLine[]
  supplierReturnLines SupplierReturnLine[]
  purchaseBillLines   PurchaseBillLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([productId, powerSph])
  @@index([updatedAt])
}

/// "Map this unknown barcode to a product once" — any scanned code (EAN, vendor code, DataMatrix payload).
model BarcodeAlias {
  code        String         @id
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  symbology   String? // EAN13, CODE128, DATAMATRIX, QR
  createdById String?
  createdAt   DateTime       @default(now())
}

// =====================================================================
// 5. Pricing — Customer override → Customer's price list → Default rate
// =====================================================================

model PriceList {
  id          String          @id @default(cuid())
  name        String          @unique // "Govt hospitals", "Private clinics – Tier A"
  description String?
  isActive    Boolean         @default(true)
  items       PriceListItem[]
  customers   Customer[]
  updatedAt   DateTime        @updatedAt
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rate        Decimal   @db.Decimal(14, 2)
  validFrom   DateTime? @db.Date // inclusive; null = open-ended
  validTo     DateTime? @db.Date // inclusive; null = open-ended
  updatedAt   DateTime  @updatedAt

  /// One rate per product per list; history lives in PriceChangeLog.
  @@unique([priceListId, productId])
  @@index([productId])
}

model CustomerPrice {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  rate       Decimal   @db.Decimal(14, 2)
  validFrom  DateTime? @db.Date // inclusive; null = open-ended
  validTo    DateTime? @db.Date // inclusive; null = open-ended
  note       String?
  updatedAt  DateTime  @updatedAt

  /// One override per product per customer; history lives in PriceChangeLog.
  @@unique([customerId, productId])
  @@index([productId])
}

/// Append-only history of every rate change (default, price list or customer override).
model PriceChangeLog {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  scope       String // DEFAULT | MRP | COST | PRICE_LIST | CUSTOMER
  scopeRefId  String? // priceListId or customerId
  oldRate     Decimal?  @db.Decimal(14, 2)
  newRate     Decimal?  @db.Decimal(14, 2)
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  changedById String
  changedBy   User      @relation(fields: [changedById], references: [id])
  source      String? // ui | excel-import
  createdAt   DateTime  @default(now())

  @@index([productId, createdAt])
}

// =====================================================================
// 6. Inventory — batches, serials, ledger, balances
// =====================================================================

model Location {
  id        String          @id @default(cuid())
  name      String          @unique // "Main store", "Rack A-3", "Van 1"
  isDefault Boolean         @default(false)
  balances  StockBalance[]
  movements StockMovement[]
}

model Batch {
  id                  String               @id @default(cuid())
  variantId           String
  variant             ProductVariant       @relation(fields: [variantId], references: [id])
  batchNo             String
  expiryDate          DateTime?            @db.Date
  mfgDate             DateTime?            @db.Date
  unitCost            Decimal?             @db.Decimal(14, 2) // landed cost for valuation
  serials             SerialUnit[]
  balances            StockBalance[]
  movements           StockMovement[]
  grnLines            GrnLine[]
  supplierReturnLines SupplierReturnLine[]
  createdAt           DateTime             @default(now())

  @@unique([variantId, batchNo])
  @@index([expiryDate]) // expiry alerts, FEFO
}

enum SerialStatus {
  IN_STOCK
  RESERVED
  SOLD
  RETURNED
  RETURNED_TO_SUPPLIER
  WRITTEN_OFF
}

model SerialUnit {
  id            String       @id @default(cuid())
  batchId       String
  batch         Batch        @relation(fields: [batchId], references: [id])
  serialNo      String
  status        SerialStatus @default(IN_STOCK)
  locationId    String?
  invoiceLineId String? // where it was sold (traceability / recalls)
  updatedAt     DateTime     @updatedAt

  @@unique([batchId, serialNo])
  @@index([serialNo])
}

/// Cached on-hand quantity per variant + batch + location (updated transactionally with StockMovement).
model StockBalance {
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  batchId    String
  batch      Batch          @relation(fields: [batchId], references: [id])
  locationId String
  location   Location       @relation(fields: [locationId], references: [id])
  qty        Int            @default(0)
  reserved   Int            @default(0) // allocated to confirmed orders, not yet invoiced
  updatedAt  DateTime       @updatedAt

  @@id([variantId, batchId, locationId])
  @@index([variantId])
}

enum MovementType {
  OPENING
  GRN // purchase receipt
  SALE // tax invoice
  SALES_RETURN // credit note
  PURCHASE_RETURN // return to supplier
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  INVOICE_CANCEL // reversal of a cancelled invoice
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  SAMPLE
  CORRECTION
  LOST
}

/// Immutable stock ledger. Opening/purchases/sales/returns/adjustments → closing balance per item.
model StockMovement {
  id          String            @id @default(cuid())
  type        MovementType
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  batchId     String
  batch       Batch             @relation(fields: [batchId], references: [id])
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  qty         Int // +in / -out
  serialNos   String[]
  unitCost    Decimal?          @db.Decimal(14, 2)
  reason      AdjustmentReason? // required when type = ADJUSTMENT (enforced in service)
  note        String?
  refType     String? // Invoice | Grn | CreditNote | PurchaseReturn
  refId       String?
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([batchId])
  @@index([refType, refId])
}

// =====================================================================
// 7. Sales — orders, dispatch, proforma, tax invoice, credit notes, payments
// =====================================================================

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  ON_HOLD
}

enum OrderSource {
  PORTAL
  MOBILE_APP
  STAFF // phone / WhatsApp order entered by staff
}

model SalesOrder {
  id                String      @id @default(cuid())
  number            String      @unique // SO-2026-00412
  customerId        String
  customer          Customer    @relation("OrderCustomer", fields: [customerId], references: [id])
  forDoctorId       String? // "for Dr. X at Hospital Y"
  forDoctor         Customer?   @relation("OrderForDoctor", fields: [forDoctorId], references: [id])
  status            OrderStatus @default(PLACED)
  source            OrderSource
  shippingAddressId String?
  shippingSnapshot  Json? // address as at order time
  customerNote      String?
  patientName       String?
  surgeryDate       DateTime?   @db.Date
  placedById        String
  assignedToId      String?
  assignedTo        User?       @relation("OrderAssignee", fields: [assignedToId], references: [id])
  clientRequestId   String?     @unique // idempotency key for offline/mobile submits

  lines         SalesOrderLine[]
  events        OrderStatusEvent[]
  dispatches    Dispatch[]
  proformas     Proforma[]
  invoices      Invoice[]
  purchaseLines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([assignedToId])
}

model SalesOrderLine {
  id            String         @id @default(cuid())
  orderId       String
  order         SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  qty           Int
  qtyDispatched Int            @default(0) // qty - qtyDispatched = back-order
  rate          Decimal        @db.Decimal(14, 2) // resolved customer price at order time
  discPct       Decimal        @default(0) @db.Decimal(5, 2)
  note          String?
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  byUserId  String
  byUser    User        @relation(fields: [byUserId], references: [id])
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Dispatch {
  id                   String         @id @default(cuid())
  orderId              String
  order                SalesOrder     @relation(fields: [orderId], references: [id])
  invoiceId            String?        @unique
  invoice              Invoice?       @relation(fields: [invoiceId], references: [id])
  method               DispatchMethod @default(COURIER)
  courier              String? // courier company or transporter name
  docketNo             String? // docket / LR no.
  vehicleNo            String?
  /// Own delivery: an employee (delivery boy) from the system, or a name + mobile for someone else.
  deliveryPersonId     String?
  deliveryPerson       User?          @relation("Deliveries", fields: [deliveryPersonId], references: [id])
  deliveryPersonName   String?
  deliveryPersonMobile String?
  dispatchDate         DateTime       @db.Date
  scanVerified         Boolean        @default(false) // packed items matched order by scan
  /// Proof of delivery
  deliveredAt          DateTime?
  receivedBy           String?
  deliveryNote         String?
  createdAt            DateTime       @default(now())

  @@index([deliveryPersonId, deliveredAt])
}

/// How goods leave: by our own delivery staff (same city), courier, transport (LR), or collected by the customer.
enum DispatchMethod {
  OWN_DELIVERY
  COURIER
  TRANSPORT
  PICKUP
}

enum ProformaStatus {
  DRAFT
  SENT
  CONVERTED
  EXPIRED
  CANCELLED
}

model Proforma {
  id                String         @id @default(cuid())
  number            String         @unique // KE/PI/2026-27/0001
  financialYear     String
  date              DateTime       @db.Date
  validUntil        DateTime       @db.Date
  status            ProformaStatus @default(DRAFT)
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])
  orderId           String?
  order             SalesOrder?    @relation(fields: [orderId], references: [id])
  supplierSnapshot  Json           @default("{}")
  taxType           TaxType        @default(INTRA_STATE)
  buyerSnapshot     Json
  consigneeSnapshot Json
  placeOfSupply     String // state code
  terms             String?
  taxableTotal      Decimal        @db.Decimal(14, 2)
  taxTotal          Decimal        @db.Decimal(14, 2)
  roundOff          Decimal        @db.Decimal(6, 2)
  grandTotal        Decimal        @db.Decimal(14, 2)
  pdfFileId         String?
  lines             ProformaLine[]
  invoice           Invoice?
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ProformaLine {
  id          String         @id @default(cuid())
  proformaId  String
  proforma    Proforma       @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  sl          Int
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  description String
  hsnCode     String
  qty         Int
  unit        String
  rate        Decimal        @db.Decimal(14, 2)
  discPct     Decimal        @default(0) @db.Decimal(5, 2)
  amount      Decimal        @db.Decimal(14, 2)
  gstRate     Decimal        @db.Decimal(5, 2)
}

enum InvoiceStatus {
  ISSUED
  CANCELLED // never deleted
}

enum TaxType {
  INTRA_STATE // CGST + SGST
  INTER_STATE // IGST
}

model Invoice {
  id            String        @id @default(cuid())
  /// A bill brought over from Tally (bill-wise opening): no lines and no voucher; its amount is part of the party ledger's opening balance.
  isOpening         Boolean      @default(false)
  number        String        @unique // KE/2026-27/0001
  financialYear String
  date          DateTime      @db.Date
  dueDate       DateTime      @db.Date
  status        InvoiceStatus @default(ISSUED)
  taxType       TaxType
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?
  order         SalesOrder?   @relation(fields: [orderId], references: [id])
  proformaId    String?       @unique
  proforma      Proforma?     @relation(fields: [proformaId], references: [id])

  // Snapshots — the PDF is always reproducible exactly as issued.
  supplierSnapshot  Json
  buyerSnapshot     Json
  consigneeSnapshot Json
  placeOfSupply     String // state code

  // Tally right-side grid
  deliveryNote      String?
  paymentTerms      String?
  referenceNo       String?
  otherReferences   String?
  buyersOrderNo     String?
  buyersOrderDate   DateTime? @db.Date
  dispatchDocNo     String?
  deliveryNoteDate  DateTime? @db.Date
  dispatchedThrough String?
  destination       String?
  termsOfDelivery   String?
  terms             String? // terms & declaration printed on the invoice (snapshot)

  taxableTotal Decimal @db.Decimal(14, 2)
  cgstTotal    Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal    Decimal @default(0) @db.Decimal(14, 2)
  igstTotal    Decimal @default(0) @db.Decimal(14, 2)
  roundOff     Decimal @default(0) @db.Decimal(6, 2)
  grandTotal   Decimal @db.Decimal(14, 2)
  amountPaid   Decimal @default(0) @db.Decimal(14, 2) // maintained from PaymentAllocation

  cancelReason  String?
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])

  // Phase 2: e-invoice / e-way bill readiness
  irn          String?
  ackNo        String?
  ackDate      DateTime?
  signedQr     String?
  ewayBillNo   String?
  ewayBillDate DateTime?

  pdfFileId       String?
  clientRequestId String? @unique // idempotency for offline scan-to-invoice
  createdById     String
  createdBy       User    @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  lines       InvoiceLine[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]
  dispatch    Dispatch?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, date])
  @@index([date])
  @@index([status])
}

model InvoiceLine {
  id          String         @id @default(cuid())
  invoiceId   String
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sl          Int
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  batchId     String?
  description String // snapshot
  hsnCode     String
  qty         Int
  unit        String
  rate        Decimal        @db.Decimal(14, 2) // price actually charged (history preserved)
  discPct     Decimal        @default(0) @db.Decimal(5, 2)
  amount      Decimal        @db.Decimal(14, 2) // taxable value
  gstRate     Decimal        @db.Decimal(5, 2)
  cgstAmount  Decimal        @default(0) @db.Decimal(14, 2)
  sgstAmount  Decimal        @default(0) @db.Decimal(14, 2)
  igstAmount  Decimal        @default(0) @db.Decimal(14, 2)
  costAtSale  Decimal?       @db.Decimal(14, 2) // for margin analytics
  // Printed under the description
  batchNo     String?
  expiryDate  DateTime?      @db.Date
  powerLabel  String?
  serialNos   String[]
}

model CreditNote {
  id               String           @id @default(cuid())
  number           String           @unique // KE/CN/2026-27/0001
  /// e-invoice (IRN) for the credit note, when e-invoicing applies.
  irn              String?
  ackNo            String?
  ackDate          DateTime?
  signedQr         String?
  financialYear    String
  date             DateTime         @db.Date
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id])
  invoiceId        String?
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  reason           String
  restock          Boolean          @default(true) // sales return puts goods back into stock
  taxType          TaxType          @default(INTRA_STATE)
  placeOfSupply    String           @default("")
  supplierSnapshot Json             @default("{}")
  buyerSnapshot    Json             @default("{}")
  taxableTotal     Decimal          @db.Decimal(14, 2)
  cgstTotal        Decimal          @default(0) @db.Decimal(14, 2)
  sgstTotal        Decimal          @default(0) @db.Decimal(14, 2)
  igstTotal        Decimal          @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal          @db.Decimal(14, 2)
  roundOff         Decimal          @default(0) @db.Decimal(6, 2)
  grandTotal       Decimal          @db.Decimal(14, 2)
  pdfFileId        String?
  lines            CreditNoteLine[]
  createdById      String
  createdAt        DateTime         @default(now())
}

model CreditNoteLine {
  id            String         @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote     @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  invoiceLineId String?
  sl            Int            @default(1)
  description   String         @default("")
  hsnCode       String         @default("")
  unit          String         @default("pcs")
  batchId       String?
  batchNo       String?
  expiryDate    DateTime?      @db.Date
  powerLabel    String?
  serialNos     String[]
  qty           Int
  rate          Decimal        @db.Decimal(14, 2)
  discPct       Decimal        @default(0) @db.Decimal(5, 2)
  amount        Decimal        @db.Decimal(14, 2)
  gstRate       Decimal        @db.Decimal(5, 2)
  cgstAmount    Decimal        @default(0) @db.Decimal(14, 2)
  sgstAmount    Decimal        @default(0) @db.Decimal(14, 2)
  igstAmount    Decimal        @default(0) @db.Decimal(14, 2)
}

enum PaymentMode {
  CASH
  UPI
  NEFT_RTGS
  CHEQUE
  CARD
  OTHER
}

model Payment {
  id          String              @id @default(cuid())
  number      String              @unique
  customerId  String
  customer    Customer            @relation(fields: [customerId], references: [id])
  date        DateTime            @db.Date
  amount      Decimal             @db.Decimal(14, 2)
  mode        PaymentMode
  reference   String? // UTR / cheque no.
  note        String?
  /// Cash / bank ledger the money went into; null = Cash for cash receipts, else the default bank.
  ledgerId    String?
  ledger      Ledger?             @relation(fields: [ledgerId], references: [id])
  allocations PaymentAllocation[]
  createdById String
  createdAt   DateTime            @default(now())

  @@index([customerId, date])
}

/// Which invoices a payment settles (drives outstanding + ageing 0–30 / 31–60 / 61–90 / 90+).
model PaymentAllocation {
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(14, 2)

  @@id([paymentId, invoiceId])
}

// =====================================================================
// 8. Purchasing — PO, GRN, returns to supplier
// =====================================================================

enum PoStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  number           String              @unique // KE/PO/2026-27/0001
  financialYear    String
  date             DateTime            @db.Date
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  status           PoStatus            @default(DRAFT)
  expectedDate     DateTime?           @db.Date
  terms            String?
  note             String?
  taxType          TaxType             @default(INTRA_STATE)
  /// Issuer (our company) and vendor details as printed, frozen when the PO is saved.
  companySnapshot  Json?
  supplierSnapshot Json?
  taxableTotal     Decimal             @db.Decimal(14, 2)
  cgstTotal        Decimal             @default(0) @db.Decimal(14, 2)
  sgstTotal        Decimal             @default(0) @db.Decimal(14, 2)
  igstTotal        Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal             @db.Decimal(14, 2)
  roundOff         Decimal             @default(0) @db.Decimal(14, 2)
  grandTotal       Decimal             @db.Decimal(14, 2)
  pdfFileId        String?
  sentAt           DateTime?
  cancelReason     String?
  cancelledAt      DateTime?
  closeReason      String?
  closedAt         DateTime?
  lines            PurchaseOrderLine[]
  grns             Grn[]
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status])
}

model PurchaseOrderLine {
  id           String         @id @default(cuid())
  poId         String
  po           PurchaseOrder  @relation(fields: [poId], references: [id], onDelete: Cascade)
  sl           Int
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  description  String
  hsnCode      String
  qtyOrdered   Int
  qtyReceived  Int            @default(0) // shortfall = ordered - received stays open
  unit         String
  rate         Decimal        @db.Decimal(14, 2)
  discPct      Decimal        @default(0) @db.Decimal(5, 2)
  gstRate      Decimal        @db.Decimal(5, 2)
  amount       Decimal        @db.Decimal(14, 2)
  expectedDate DateTime?      @db.Date
  grnLines     GrnLine[]
  /// Ordered for a specific customer order (item was out of stock when the doctor ordered).
  salesOrderId String?
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id])

  @@index([salesOrderId])
}

model Grn {
  id                  String         @id @default(cuid())
  number              String         @unique
  date                DateTime       @db.Date
  /// null for an opening-stock entry
  supplierId          String?
  supplier            Supplier?      @relation(fields: [supplierId], references: [id])
  isOpening           Boolean        @default(false)
  note                String?
  poId                String?
  po                  PurchaseOrder? @relation(fields: [poId], references: [id])
  supplierInvoiceNo   String?
  supplierInvoiceDate DateTime?      @db.Date
  lines               GrnLine[]
  purchaseBills       PurchaseBill[]
  createdById         String
  createdAt           DateTime       @default(now())
}

model GrnLine {
  id         String             @id @default(cuid())
  grnId      String
  grn        Grn                @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId   String?
  poLine     PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  variantId  String
  variant    ProductVariant     @relation(fields: [variantId], references: [id])
  batchId    String?
  batch      Batch?             @relation(fields: [batchId], references: [id])
  batchNo    String
  expiryDate DateTime?          @db.Date
  serialNos  String[]
  qty        Int
  rate       Decimal            @db.Decimal(14, 2)
  locationId String
}

/// Goods sent back to a supplier (damaged, near-expiry, wrong item). Posts PURCHASE_RETURN movements.
model SupplierReturn {
  id           String               @id @default(cuid())
  number       String               @unique // KE/DN/2026-27/0001 (debit note series)
  date         DateTime             @db.Date
  supplierId   String
  supplier     Supplier             @relation(fields: [supplierId], references: [id])
  reason       String
  note         String?
  /// Debit note value: qty × the batch unit cost, GST at the product rate (CGST+SGST or IGST by supplier state).
  taxType      TaxType              @default(INTRA_STATE)
  taxableTotal Decimal              @default(0) @db.Decimal(14, 2)
  cgstTotal    Decimal              @default(0) @db.Decimal(14, 2)
  sgstTotal    Decimal              @default(0) @db.Decimal(14, 2)
  igstTotal    Decimal              @default(0) @db.Decimal(14, 2)
  taxTotal     Decimal              @default(0) @db.Decimal(14, 2)
  roundOff     Decimal              @default(0) @db.Decimal(14, 2)
  grandTotal   Decimal              @default(0) @db.Decimal(14, 2)
  lines        SupplierReturnLine[]
  createdById  String
  createdAt    DateTime             @default(now())
}

model SupplierReturnLine {
  id         String         @id @default(cuid())
  returnId   String
  return     SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  batchId    String
  batch      Batch          @relation(fields: [batchId], references: [id])
  locationId String
  qty        Int
  serialNos  String[]
}

// =====================================================================
// 9. Notifications & website leads
// =====================================================================

enum NotificationChannel {
  IN_APP
  PUSH
  SMS
  WHATSAPP
  EMAIL
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  title     String
  body      String
  link      String? // deep link, e.g. /orders/SO-2026-00412
  status    String              @default("queued") // queued | sent | failed
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// Website enquiry form submissions.
model Lead {
  id                  String        @id @default(cuid())
  name                String
  organisation        String?
  type                CustomerType?
  mobile              String
  email               String?
  city                String?
  message             String
  productIds          String[]
  status              LeadStatus    @default(NEW)
  convertedCustomerId String?
  /// Staff follow-up notes.
  notes               String?
  handledById         String?
  /// Website page the enquiry came from (product page, contact page).
  sourcePath          String?
  ip                  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

// =====================================================================
// 10. Counters (barcodes, customer codes)
// =====================================================================

/// Global monotonic counters, allocated atomically with UPDATE ... RETURNING.
model Counter {
  key   String @id // "barcode" | "customer" | "supplier"
  value Int    @default(0)
}

// =====================================================================
// 11. Accounts — double entry, Tally conventions
// =====================================================================
// Every money document (invoice, credit note, receipt, purchase bill, debit note, supplier payment)
// posts one Voucher in the same transaction. Amounts are signed: + Debit, − Credit; a voucher's
// entries always sum to zero. Groups and posting rules live in @kush/core (accounts.ts).

enum VoucherType {
  SALES
  CREDIT_NOTE
  RECEIPT
  PURCHASE
  DEBIT_NOTE
  PAYMENT
  CONTRA
  JOURNAL
}

model Ledger {
  id             String    @id @default(cuid())
  name           String    @unique
  group          String // ACCOUNT_GROUPS key, e.g. SUNDRY_DEBTORS
  /// Ledgers the app posts to by key: CASH, BANK, ROUND_OFF, OUTPUT_CGST, SALES_5, PURCHASE_12, ...
  systemKey      String?   @unique
  /// Party ledgers are created on demand and renamed with their customer / supplier.
  customerId     String?   @unique
  customer       Customer? @relation(fields: [customerId], references: [id])
  supplierId     String?   @unique
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  openingBalance Decimal   @default(0) @db.Decimal(14, 2) // +Dr / −Cr as on CompanySettings.booksFrom
  bankAccountNo  String?
  bankIfsc       String?
  note           String?
  isActive       Boolean   @default(true)

  entries           VoucherEntry[]
  partyVouchers     Voucher[]          @relation("VoucherParty")
  payments          Payment[]
  supplierPayments  SupplierPayment[]
  purchaseBillLines PurchaseBillLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
}

model Voucher {
  id            String         @id @default(cuid())
  type          VoucherType
  number        String // the source document's number, or the voucher series for manual entries
  date          DateTime       @db.Date
  narration     String?
  /// Auto-posted vouchers: Invoice | CreditNote | Payment | PurchaseBill | SupplierReturn | SupplierPayment.
  /// They change only through their document. Null for manual vouchers.
  sourceType    String?
  sourceId      String?
  /// The party (or main other ledger) for lists.
  partyLedgerId String?
  partyLedger   Ledger?        @relation("VoucherParty", fields: [partyLedgerId], references: [id])
  amount        Decimal        @db.Decimal(14, 2) // sum of debits
  /// Cancelled vouchers stay for the record but are left out of every balance.
  cancelled     Boolean        @default(false)
  cancelReason  String?
  cancelledAt   DateTime?
  createdById   String?
  entries       VoucherEntry[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([sourceType, sourceId])
  @@index([date])
  @@index([type, date])
  @@index([number])
}

model VoucherEntry {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledgerId  String
  ledger    Ledger  @relation(fields: [ledgerId], references: [id])
  amount    Decimal @db.Decimal(14, 2) // +Dr / −Cr
  billRef   String? // bill-wise reference on party lines (invoice / supplier bill number)
  sl        Int
  /// Bank reconciliation: the date this entry appeared on the bank statement.
  reconciledOn DateTime? @db.Date

  @@index([ledgerId])
  @@index([voucherId])
}

/// A supplier's tax invoice as entered in our books (Tally purchase voucher).
model PurchaseBill {
  id           String                      @id @default(cuid())
  /// A supplier bill brought over from Tally (bill-wise opening); like Invoice.isOpening.
  isOpening    Boolean @default(false)
  number       String                      @unique // KE/PB/2026-27/0001
  supplierId   String
  supplier     Supplier                    @relation(fields: [supplierId], references: [id])
  billNo       String // the supplier's invoice number
  billDate     DateTime                    @db.Date
  dueDate      DateTime                    @db.Date
  grnId        String?
  grn          Grn?                        @relation(fields: [grnId], references: [id])
  taxType      TaxType
  taxableTotal Decimal                     @db.Decimal(14, 2)
  cgstTotal    Decimal                     @default(0) @db.Decimal(14, 2)
  sgstTotal    Decimal                     @default(0) @db.Decimal(14, 2)
  igstTotal    Decimal                     @default(0) @db.Decimal(14, 2)
  roundOff     Decimal                     @default(0) @db.Decimal(14, 2)
  grandTotal   Decimal                     @db.Decimal(14, 2)
  amountPaid   Decimal                     @default(0) @db.Decimal(14, 2) // maintained from SupplierPaymentAllocation
  status       InvoiceStatus               @default(ISSUED)
  cancelReason String?
  cancelledAt  DateTime?
  note         String?
  createdById  String
  lines        PurchaseBillLine[]
  allocations  SupplierPaymentAllocation[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([supplierId, billNo])
  @@index([billDate])
}

model PurchaseBillLine {
  id          String          @id @default(cuid())
  billId      String
  bill        PurchaseBill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  sl          Int
  /// Stock items post to Purchase GST r%; other lines (courier, rent, equipment) post to their own ledger.
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  ledgerId    String?
  ledger      Ledger?         @relation(fields: [ledgerId], references: [id])
  description String
  hsnCode     String?
  qty         Decimal?        @db.Decimal(14, 3)
  unit        String?
  rate        Decimal         @db.Decimal(14, 2)
  discPct     Decimal         @default(0) @db.Decimal(5, 2)
  amount      Decimal         @db.Decimal(14, 2) // taxable value
  gstRate     Decimal         @db.Decimal(5, 2)
  cgstAmount  Decimal         @default(0) @db.Decimal(14, 2)
  sgstAmount  Decimal         @default(0) @db.Decimal(14, 2)
  igstAmount  Decimal         @default(0) @db.Decimal(14, 2)

  @@index([billId])
}

/// Money paid to a supplier (Tally payment voucher), applied to their bills.
model SupplierPayment {
  id          String                      @id @default(cuid())
  number      String                      @unique // KE/PV/2026-27/0001 (payment voucher series)
  supplierId  String
  supplier    Supplier                    @relation(fields: [supplierId], references: [id])
  date        DateTime                    @db.Date
  amount      Decimal                     @db.Decimal(14, 2)
  mode        PaymentMode
  ledgerId    String // the cash / bank ledger paid from
  ledger      Ledger                      @relation(fields: [ledgerId], references: [id])
  reference   String? // UTR / cheque no.
  note        String?
  createdById String
  allocations SupplierPaymentAllocation[]
  createdAt   DateTime                    @default(now())

  @@index([supplierId, date])
}

model SupplierPaymentAllocation {
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  billId    String
  bill      PurchaseBill    @relation(fields: [billId], references: [id])
  amount    Decimal         @db.Decimal(14, 2)

  @@id([paymentId, billId])
}
