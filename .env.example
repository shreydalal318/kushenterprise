# PostgreSQL (local: docker compose up -d db)
DATABASE_URL="postgresql://kush:kush@localhost:5432/kush"
TEST_DATABASE_URL="postgresql://kush:kush@localhost:5432/kush_test"

# First owner account created by `pnpm db:seed` (change the password after first login)
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_MOBILE="+919999999999"
SEED_OWNER_PASSWORD="ChangeMe!2026"

# Secret for OTP hashing. Required in production: generate with `openssl rand -base64 48`
AUTH_SECRET=""

# Session cookie security: set to "true" behind HTTPS in production
COOKIE_SECURE="false"

# Development only: "true" shows one-click sign-in as any user on the home and sign-in screens.
# Ignored when NODE_ENV=production.
DEV_QUICK_LOGIN=""
# Hosted demo only: "true" turns quick login on even in production. Anyone with the link can sign in
# as any user, so never set it on a server with real data.
DEMO_QUICK_LOGIN=""

# File storage: "local" (dev, writes to ./storage) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# OTP / SMS: "console" logs codes to the server log (dev). A real DLT-registered provider plugs in
# once the account and templates exist (see packages/api/src/notify/sms.ts).
SMS_PROVIDER="console"

# App push notifications: "console" (log only) or "expo" (Expo push service, no key needed)
PUSH_PROVIDER="console"

# Secret for scheduled jobs (POST /api/jobs/notifications with header x-job-secret). 16+ characters.
JOB_SECRET=""

# Public website address (used in sitemap.xml, robots.txt and links)
SITE_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta) for order updates and documents. Leave blank to log messages instead.
# The template (default "kush_update") needs two body parameters: {{1}} title, {{2}} message.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="kush_update"
WHATSAPP_LANG="en"

# Email through any SMTP server, e.g. smtps://user:password@smtp.example.com:465. Blank = log only.
SMTP_URL=""
EMAIL_FROM="Kush Enterprise <accounts@example.com>"
