# PostgreSQL (local: docker compose up -d db)
DATABASE_URL="postgresql://kush:kush@localhost:5432/kush"
TEST_DATABASE_URL="postgresql://kush:kush@localhost:5432/kush_test"

# First owner account created by `pnpm db:seed` (change the password after first login)
SEED_OWNER_NAME="Owner"
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_MOBILE="+919999999999"
SEED_OWNER_PASSWORD="ChangeMe!2026"

# Secret for OTP hashing. Required in production: generate with `openssl rand -base64 48`
AUTH_SECRET=""

# Session cookie security: set to "true" behind HTTPS in production
COOKIE_SECURE="false"

# File storage: "local" (dev, writes to ./storage) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# OTP / SMS: "console" logs codes to the server log (dev). Real providers are added in Phase 6.
SMS_PROVIDER="console"
